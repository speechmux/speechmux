# Sub-repos — cloned separately via make clone-*
# Patterns cover current and future plugins automatically.
proto/
core/
plugin-*/
client-*/

# Python virtual environment (workspace-level .venv used by Makefile)
.venv/

# Claude Code local state. .claude/skills is tracked — it is a symlink to
# .codex/skills/, which is the canonical source for agent skills.
.claude/*
!.claude/skills
.claude/settings.local.json

# Sample audio files (not tracked — no references in docs or Makefile)
assets/

# Docker
.env
models/

# macOS
.DS_Store
